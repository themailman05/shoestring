# --- optional ---------------------------------------------------------------
# AKASH_API=https://console-api.akash.network/v1
# HF_TOKEN=               # only for gated/private HF repos
# MODEL_ID=               # override default model for the chosen engine
# MODEL_ALIAS=qwen3.8-27b # served-model-name / client config label
# MAX_CTX=                # vLLM engines only (llamacpp self-sizes; --max-ctx pins)
# NO_MTP=1                # llamacpp: drop speculative draft (24GB cards)
# KV_F16=1                # llamacpp: full-precision KV (halves ctx, zero quant loss)
# VLLM_IMAGE=vllm/vllm-openai:latest
# LLAMACPP_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda
# COMFY_IMAGE=pytorch/pytorch:2.9.1-cuda12.8-cudnn9-runtime
# QWEN_TEXT_ENCODER=text_encoders/qwen3vl_8b_int8_convrot.safetensors
# QWEN_VAE=vae/qwen_image_2.1_vae_bf16.safetensors
# COMFY_ARGS=             # extra ComfyUI main.py flags, e.g. --lowvram
# BLACKLIST=addr1,addr2   # comma-separated provider addresses to skip
